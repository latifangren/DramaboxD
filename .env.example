# Base URL API upstream DramaBox (pola SekaiDrama: route per provider di bawah base ini)
# Default publik: https://api.sansekai.my.id/api  -> endpoint /dramabox/search, /dramabox/detail, dst.
DRAMABOX_API_BASE=https://api.sansekai.my.id/api

# Jeda antar request (ms) dan timeout per request (ms)
DRACIN_DELAY_MS=500
DRACIN_TIMEOUT_MS=30000

# Folder output default untuk file .m3u
DRACIN_OUT_DIR=output

# Base URL API FreeReels (hasil reverse APK; termasuk prefix /frv2-api)
FREEREELS_API_BASE=https://apiv2.free-reels.com/frv2-api
# Nama perangkat untuk sesi tamu FreeReels, format "<BRAND> <MODEL>" (opsional)
# FREEREELS_DEVICE_NAME=Google Pixel 8

# Base URL API Melolo (hasil reverse APK)
MELOLO_API_BASE=https://api.tmtreader.com
# device_id numerik untuk parameter umum Melolo (opsional)
# MELOLO_DEVICE_ID=

# Base situs PineDrama (jalur web) + bahasa episode
PINEDRAMA_SITE_BASE=https://pinedrama.com
# PINEDRAMA_LANGUAGE=en
# === NetShort (jalur web) ===
NETSHORT_SITE_BASE=https://netshort.com
NETSHORT_LANGUAGE=en

# === FlickReels (jalur web) ===
FLICKREELS_SITE_BASE=https://www.flickreels.net

# === ShortMax (jalur web resmi shorttv.live) ===
SHORTMAX_API_BASE=https://shortweb.shorttv.live/app-api/app
SHORTMAX_LANGUAGE=en

# === GoodShort (jalur web resmi goodshort.com) ===
GOODSHORT_SITE_BASE=https://www.goodshort.com
GOODSHORT_LANGUAGE=en
